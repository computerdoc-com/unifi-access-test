# Copy to .env and fill in. Do NOT commit .env — the token has full API access.
#
# UniFi Access API token: UniFi Access app -> General -> Advanced -> API Token
UNIFI_ACCESS_API=

# Hostname or IP of the UniFi Access controller.
UNIFI_ACCESS_HOST=

# API port. Defaults to 12445 if unset.
#UNIFI_ACCESS_PORT=12445
